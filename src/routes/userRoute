const express = require("express");
const router = express.Router();

const users = [
    { id: 1, username: "pavi", email: "pavi@gmail.com", password: "10023" },
    { id: 2, username: "jhon", email: "jhon@gmail.com", password: "17232" },
    { id: 3, username: "pal", email: "pal@gmail.com", password: "97756" },
    { id: 4, username: "pandith", email: "pandith@gmail.com", password: "99856" },
    { id: 5, username: "Ram", email: "ram@gmail.com", password: "78256" },

];


router.use((req, res, next) => {
    console.log("User routes accessed");
    next(); 
});


router.get("/users", (req, res) => {
    res.json(users);
});


router.get("/users/:id", (req, res) => {
    const userId = parseInt(req.params.id);
    const user = users.find((user) => user.id === userId);
    if (user) {
        res.json(user);
    } else {
        res.status(404).json({ error: "User not found" });
    }
});


router.post("/users", (req, res) => {
    const { username, password, email, role } = req.body;
    
    if (!username) {
        return res.status(400).json({ error: "Username is required" });
    }

    const newUser = {
        id: users.length + 1,
        username,
        password,
        email,
        role: role || "default"
    };

    users.push(newUser);
    res.status(201).json(newUser);
});


router.put("/users/:id", (req, res) => {
    const userId = parseInt(req.params.id);
    const user = users.find((user) => user.id === userId);

    if (user) {
        user.username = req.body.username || user.username;
        user.email = req.body.email || user.email;
        user.password = req.body.password || user.password;
        user.role = req.body.role || user.role;

        res.json(user);
    } else {
        res.status(404).json({ error: "User not found" });
    }
});

router.delete("/users/:id", (req, res) => {
    const userId = parseInt(req.params.id);
    const index = users.findIndex((user) => user.id === userId);

    if (index === -1) {
        res.status(404).json({ error: "User does not exist" });
    } else {
        const deletedUser = users.splice(index, 1)[0];
        res.json(deletedUser);
    }
});

module.exports = router;